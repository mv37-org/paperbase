# Shared
PAPERBASE_DATABASE_URL="postgresql+psycopg:///paperbase"
PAPERBASE_STORAGE_BACKEND="local"
PAPERBASE_LOCAL_STORAGE_ROOT=".paperbase-data"
PAPERBASE_API_KEY="development-token"
PAPERBASE_BASE_URL="http://127.0.0.1:8080"
PAPERBASE_LOG_LEVEL="INFO"
PAPERBASE_LOG_FORMAT="text"

# API
PAPERBASE_API_HOST="127.0.0.1"
PAPERBASE_API_PORT="8080"
PAPERBASE_BROWSER_ORIGIN="http://127.0.0.1:5173"
PAPERBASE_CHAT_PUBLIC_URL="http://127.0.0.1:5173"
PAPERBASE_APP_SECRET="paperbase-development-secret"
PAPERBASE_ENCRYPTION_KEY=""
PAPERBASE_BROWSER_SESSION_COOKIE_NAME="paperbase_browser_session"
PAPERBASE_BROWSER_SESSION_TTL_SECONDS="2592000"
PAPERBASE_BROWSER_SESSION_SECURE="false"
PAPERBASE_PASSWORD_RESET_TTL_SECONDS="3600"
PAPERBASE_ADMIN_EMAILS=""
PAPERBASE_UPLOAD_MAX_BYTES="25000000"

# Worker
PAPERBASE_WORKER_HOST="127.0.0.1"
PAPERBASE_SYNC_INTERVAL_SECONDS="3600"
PAPERBASE_WORKER_STATUS_URL=""
PAPERBASE_WORKER_POLL_INTERVAL_SECONDS="10"
PAPERBASE_WORKER_AUTO_SYNC_LATEST="false"
PAPERBASE_WORKER_INITIAL_SYNC_LATEST="false"
PAPERBASE_ARXIV_CATEGORIES='["cs.AI","cs.LG","cs.CL","cs.CV","cs.NE","cs.MA","cs.RO","stat.ML","cs.IR","cs.SD","eess.AS","cs.HC","cs.CR"]'
PAPERBASE_LATEST_SYNC_DAYS="7"
PAPERBASE_LATEST_SYNC_LIMIT_PER_CATEGORY="100"
PAPERBASE_RESULT_TTL_DAYS="7"
PAPERBASE_EMBEDDING_MODEL="allenai/specter2_base"
PAPERBASE_EMBEDDING_DIM="768"
PAPERBASE_RERANK_MODEL=""
PAPERBASE_RERANK_TOP_K="50"
PAPERBASE_SUMMARY_PROVIDER="none"
PAPERBASE_SUMMARY_MODEL="gemini-2.5-flash-lite"
PAPERBASE_LAZY_SUMMARY_ON_READ="true"
PAPERBASE_FEATURED_TIER_CONCURRENCY="16"
PAPERBASE_RRF_K="60"
PAPERBASE_CITATION_BOOST_SCALE="0.003"
PAPERBASE_CITATION_BOOST_MAX="0.015"
PAPERBASE_CHUNK_MAX_CHARS="1500"
PAPERBASE_CHUNK_OVERLAP_CHARS="300"
PAPERBASE_LIVE_SOURCE_WEIGHT="0.8"
PAPERBASE_LIVE_SOURCE_WEIGHT_RECENT="1.2"
PAPERBASE_QUERY_EXPANSION_VARIANTS="4"
PAPERBASE_FETCH_REFERENCES_AT_INDEX="false"
# Layer-1 code-url crosslink: exact arXiv-id lookup against Hugging Face paper
# search (``/api/papers/search?q=<id>``), using the paper page's ``githubRepo``
# when present. Default on in code; set false here to disable locally.
PAPERBASE_FETCH_CODE_CROSSLINKS_AT_INDEX="true"

# Chat
VITE_PAPERBASE_BASE_URL="http://127.0.0.1:8080"
PAPERBASE_PLUGIN_TRANSPORT="streamable-http"
PAPERBASE_PLUGIN_MOUNT_PATH="/mcp"
FASTMCP_HOST="127.0.0.1"
FASTMCP_PORT="8090"

# Cloud / Optional
PAPERBASE_RESEND_API_KEY=""
PAPERBASE_RESEND_FROM_EMAIL="Paperbase <auth@paperbase.local>"
PAPERBASE_GOOGLE_CLIENT_ID=""
PAPERBASE_GOOGLE_CLIENT_SECRET=""
PAPERBASE_GOOGLE_OAUTH_REDIRECT_URL=""
# Required for the in-app GitHub connection used by project Python files and repo sync.
PAPERBASE_GITHUB_CLIENT_ID=""
PAPERBASE_GITHUB_CLIENT_SECRET=""
PAPERBASE_GITHUB_OAUTH_REDIRECT_URL=""
# Service-level GitHub token for code-url verification + paper-code ingestion.
# NOT the user OAuth credential above. Lifts the anonymous 60 req/hr REST and
# 10 req/min Search caps that otherwise dominate affiliation-based recall on
# the code_url benchmark (MAE / InfoGAN / PPO miss without it). Use a fine-
# grained PAT with public-repo read scope.
PAPERBASE_GITHUB_TOKEN=""
PAPERBASE_ANTHROPIC_API_KEY=""
PAPERBASE_ANTHROPIC_BASE_URL="https://api.anthropic.com"
PAPERBASE_ANTHROPIC_MODEL="claude-opus-4-7"
PAPERBASE_GCS_PROJECT=""
PAPERBASE_GCS_BUCKET="paperbase"
PAPERBASE_GCS_PUBLIC_BASE_URL=""
PAPERBASE_GCS_SERVICE_ACCOUNT_JSON=""
PAPERBASE_PRESIGN_TTL_SECONDS="3600"
PAPERBASE_VERTEX_PROJECT=""
PAPERBASE_VERTEX_LOCATION="us-central1"
