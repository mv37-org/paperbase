# Copy this file to `paperbase/.env` for local development.
# On Railway, add these as service variables instead of uploading a real `.env` file.

# Auth
PAPERBASE_API_KEY=change-me

# Database
PAPERBASE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/paperbase

# Storage backend
PAPERBASE_STORAGE_BACKEND=r2

# Cloudflare R2 credentials
PAPERBASE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
PAPERBASE_R2_ACCESS_KEY_ID=
PAPERBASE_R2_SECRET_ACCESS_KEY=
PAPERBASE_R2_BUCKET=paperbase
PAPERBASE_R2_REGION_NAME=auto

# Optional public base URL for already-public R2 assets.
# Leave blank to use signed URLs generated via the S3-compatible API.
PAPERBASE_R2_PUBLIC_BASE_URL=

# Runtime tuning
PAPERBASE_PRESIGN_TTL_SECONDS=3600
PAPERBASE_SYNC_INTERVAL_SECONDS=3600
PAPERBASE_WORKER_POLL_INTERVAL_SECONDS=10
PAPERBASE_LATEST_SYNC_DAYS=7
PAPERBASE_LATEST_SYNC_LIMIT_PER_CATEGORY=100
PAPERBASE_RESULT_TTL_DAYS=7

# Optional embeddings
PAPERBASE_EMBEDDING_MODEL=

# Optional local overrides only.
# Railway injects `PORT` automatically, so you usually do not need these there.
# PAPERBASE_API_HOST=0.0.0.0
# PAPERBASE_API_PORT=8080
